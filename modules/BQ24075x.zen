# pcb:sch R_PG.R x=1233.4400 y=189.5000 rot=180
# pcb:sch R_SYSOFF.R x=1220.7400 y=875.3000 rot=0
# pcb:sch R_TMR.R x=1093.7400 y=875.3000 rot=0
