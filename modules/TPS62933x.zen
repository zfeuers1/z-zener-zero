"""
TPS62933x Reference Design

TPS62933DRLR synchronous buck converter (3.8V-30V input, up to 3A output).
Based on TPS62933 datasheet typical application circuit (Figure 10-1).

Features:
- 3.8V to 30V input voltage range
- 0.8V to 22V adjustable output voltage
- Up to 3A continuous output current
- Integrated 76mΩ and 32mΩ MOSFETs
- Ultra-low quiescent current (12µA typical)
- Adjustable switching frequency (200kHz-2.2MHz)
- Internal loop compensation (no external compensation needed)
- Pulse frequency modulation for high light-load efficiency
"""

load("@stdlib/interfaces.zen", "Power", "Ground", "Gpio")

Capacitor = Module("@stdlib/generics/Capacitor.zen")
Resistor = Module("@stdlib/generics/Resistor.zen")
Inductor = Module("@stdlib/generics/Inductor.zen")
TPS62933 = Module("//components/TPS62933DRLR/TPS62933DRLR.zen")

# Define module interfaces
vin = io("vin", Power)       # Input voltage (3.8V-30V)
vout = io("vout", Power)     # Output voltage (configurable)
gnd = io("gnd", Ground)
en = io("en", Gpio, optional=True)  # Enable input (active high, internal pullup)
pg = io("pg", Gpio, optional=True)  # Power good output (not available on TPS62933 basic variant)

# Configuration: Output voltage
config_vout = config("config_vout", float, default=3.3, optional=False)

# Configuration: Switching frequency (default 500kHz by floating RT pin)
FrequencyMode = enum("500kHz", "1200kHz")
config_frequency = config("config_frequency", FrequencyMode, default="500kHz", optional=False)

# Internal nets
_EN = Net("_EN")
_SW = Net("_SW")
_BST = Net("_BST")
_FB = Net("_FB")
_SS = Net("_SS")
_RT = Net("_RT")

# TPS62933 IC
TPS62933(
    name = "U_BUCK",
    VIN = vin.NET,
    GND = gnd.NET,
    SW = _SW,
    BST = _BST,
    FB = _FB,
    EN = _EN,
    SS = _SS,  # Soft-start pin (TPS62933 has SS, not PG)
    RT = _RT,  # Frequency programming
)

# Input capacitor (10µF ceramic, X5R or better)
Capacitor(name = "C_IN", value = "10uF", voltage = "50V", package = "1206", 
          P1 = vin.NET, P2 = gnd.NET)

# Bootstrap capacitor with series resistor (optional, reduces SW spike)
# Resistor < 10Ω recommended per datasheet
Resistor(name = "R_BST", value = "4.7ohm 5%", package = "0402",
         P1 = _BST, P2 = Net("BST_CAP"))
Capacitor(name = "C_BST", value = "100nF", voltage = "16V", package = "0402",
          P1 = Net("BST_CAP"), P2 = _SW)

# Output inductor (6.8µH for 3.3V@3A, 500kHz)
# For 3.3V output: L = 6.8µH, Isat > 5.8A, RMS > 3A
Inductor(name = "L_OUT", value = "6.8uH", current = "5A", package = "1210",
         P1 = _SW, P2 = vout.NET)

# Output capacitor (22µF ceramic, X5R or better, low ESR)
Capacitor(name = "C_OUT1", value = "22uF", voltage = "10V", package = "1206",
          P1 = vout.NET, P2 = gnd.NET)
Capacitor(name = "C_OUT2", value = "22uF", voltage = "10V", package = "1206",
          P1 = vout.NET, P2 = gnd.NET)

# Feedback resistor divider
# VOUT = VREF * (1 + R_FBT / R_FBB), where VREF = 0.8V
# For 3.3V: R_FBT = (3.3 - 0.8) / 0.8 * 10k = 31.25k → use 31.6k
# Using 1% tolerance resistors
R_FBB_VALUE = "10kohm 1%"
if config_vout == 3.3:
    R_FBT_VALUE = "31.6kohm 1%"
elif config_vout == 5.0:
    R_FBT_VALUE = "52.3kohm 1%"
elif config_vout == 12.0:
    R_FBT_VALUE = "140kohm 1%"
else:
    # Calculate for custom voltage: R_FBT = (VOUT - 0.8) / 0.8 * 10000
    R_FBT_OHM = int((config_vout - 0.8) / 0.8 * 10000)
    R_FBT_VALUE = str(R_FBT_OHM) + "ohm 1%"

Resistor(name = "R_FBT", value = R_FBT_VALUE, package = "0402",
         P1 = vout.NET, P2 = _FB)
Resistor(name = "R_FBB", value = R_FBB_VALUE, package = "0402",
         P1 = _FB, P2 = gnd.NET)

# Soft-start capacitor (33nF for ~5ms soft-start time)
# Minimum 6.8nF required, do not float
Capacitor(name = "C_SS", value = "33nF", voltage = "10V", package = "0402",
          P1 = _SS, P2 = gnd.NET)

# Switching frequency configuration
if config_frequency == FrequencyMode("500kHz"):
    # RT floating for 500kHz (leave unconnected, >280kΩ)
    # No connection needed
    pass
elif config_frequency == FrequencyMode("1200kHz"):
    # RT to GND for 1.2MHz (<1kΩ)
    Resistor(name = "R_RT", value = "0ohm", package = "0402",
             P1 = _RT, P2 = gnd.NET)

# Enable pin configuration
if en:
    # External enable control
    en = Gpio(NET = _EN)
else:
    # Internal pullup enables device (can float or tie high)
    # For always-on operation, can leave floating or add pull-up
    Resistor(name = "R_EN_PU", value = "100kohm 5%", package = "0402",
             P1 = vin.NET, P2 = _EN)

# Note: TPS62933 (basic variant) has SS pin, not PG pin
# For power good functionality, use TPS62933P variant
# This reference design is for TPS62933 (with SS)

