"""
ZF0001 - Wearable Voice Logger

A compact wearable device that records spoken notes while running. It streams audio 
live over Wi-Fi to a web endpoint, where a server performs transcription. It tags 
each audio chunk with GPS coordinates and battery data. Designed for long battery 
life, intuitive single-button operation, and simple USB-C connectivity.

Hardware Features:
- ESP32-S3-WROOM-1-N8R8 (8MB Flash, 8MB PSRAM, WiFi/BLE)
- Analog microphone input via 3.5mm audio jack with OPA344 amplification
- u-blox MAX-M10S GNSS module for GPS tagging
- BQ24075 battery charger with power-path management
- TPS63070 buck-boost converter (2.0-16V input, 3.3V @ 2A output)
- MAX17048 fuel gauge for battery monitoring (I2C on always-on rail)
- MicroSD card for local audio backup
- USB-C for charging and programming (with ESD protection)
- RGB status LEDs and power LED
- Boot/Reset/Record buttons for user control
- 4-layer PCB design
"""

load("@stdlib/interfaces.zen", "Analog", "Ground", "Gpio", "I2c", "Power", "Spi", "Uart", "Usb2")
load("@stdlib/board_config.zen", "Board")

# Define the board configuration
Board(
    name = "ZF0001",
    layout_path = "layout/ZF0001",
    layers = 4,
)

# Load reference design modules
ESP32S3WROOM1 = Module("../../modules/ESP32S3WROOM1x.zen")
BQ24075 = Module("../../modules/BQ24075x.zen")
TPS63070 = Module("../../modules/TPS63070x.zen")
MAX17048 = Module("../../modules/MAX17048x.zen")
MAXM10S = Module("../../modules/MAXM10Sx.zen")
AnalogMicInput = Module("../../modules/AnalogMicInput.zen")
BatteryProtectionSwitch = Module("../../modules/BatteryProtectionSwitch.zen")
UsbC = Module("@registry/modules/usb/UsbC.zen")

# Generic components
Capacitor = Module("@stdlib/generics/Capacitor.zen")
Resistor = Module("@stdlib/generics/Resistor.zen")
Led = Module("@stdlib/generics/Led.zen")
Inductor = Module("@stdlib/generics/Inductor.zen")

# Specific components
MicroSDSocket = Module("//components/MSD-12-A/MSD-12-A.zen")
TactileButton = Module("@registry/common/button.zen").SKRKAHE020

# ========================================
# Power Rails
# ========================================
VBUS_5V = Power("VBUS_5V")          # USB 5V input
VBAT_RAW = Power("VBAT_RAW")        # Battery voltage after reverse protection
VBAT_SWITCHED = Power("VBAT_SWITCHED")  # Switched battery to charger
VSYS = Power("VSYS")                # System rail from BQ24075 (always on when USB or battery)
VDD_3V3 = Power("VDD_3V3")          # Main 3.3V rail (from buck-boost converter)
VDD_3V3_ANA = Power("VDD_3V3_ANA")  # Filtered 3.3V for analog circuits
GND = Ground("GND")

# ========================================
# GPIO Signals
# ========================================
# Define all GPIO signals at top level so they can be shared between MCU and components
esp_en = Gpio("ESP_EN")
esp_boot = Gpio("ESP_BOOT")
mic_in = Gpio("MIC_IN")
btn_record = Gpio("BTN_RECORD")
led_r = Gpio("LED_R")
led_g = Gpio("LED_G")
led_b = Gpio("LED_B")
chg_stat = Gpio("CHG_STAT")
pg_stat = Gpio("PG_STAT")
fg_alert = Gpio("FG_ALERT")
sd_detect = Gpio("SD_DETECT")
gnss_reset = Gpio("GNSS_RESET")
gnss_pps = Gpio("GNSS_PPS")

# ========================================
# USB-C Connector (with ESD protection)
# ========================================
usb_data = Usb2("USB_DATA")

UsbC(
    name = "USB",
    config_usb_type = "USB2_SINK",
    config_use_usb_power = True,
    vusb = VBUS_5V,
    usb2 = usb_data,
    gnd = GND,
    properties = {
        "collapse": True
    }
)

# USB bulk input capacitor for supply stability
# Protects against voltage droop during WiFi TX pulses and ESP32 load transients
# USB cable has ~200nH/meter inductance - bulk cap reduces voltage sag
# 47µF provides low-ESR energy reservoir for high-frequency current demands
Capacitor(name = "C_BULK_VBUS", value = "47uF", voltage = "10V", package = "0805",
          P1 = VBUS_5V.NET, P2 = GND.NET)

# ========================================
# Battery Protection and Power Switch
# ========================================
# Complete battery protection circuit with:
# - JST PH-2 connector for Li-Ion battery
# - Optional PPTC fuse for overcurrent protection (using 0Ω jumper)
# - P-FET reverse polarity protection via body diode (VBAT_RAW output, always-on)
# - Mechanical slide switch with P-FET high-side switching (VBAT_SWITCHED output)
BatteryProtectionSwitch(
    name = "BAT_PROTECT",
    vbat_in = Power("VBAT_IN_DUMMY"),  # Internal to module (connector included)
    vbat_raw = VBAT_RAW,                # Always-on protected battery (for voltage dividers)
    vbat_switched = VBAT_SWITCHED,      # Switched output (to charger)
    gnd = GND,
    config_fuse_type = "ZERO_OHM",     # Use 0Ω jumper (can change to "PPTC" if needed)
    config_include_connector = True,    # Include JST connector
    properties = {
        "collapse": True
    }
)

# ========================================
# Battery Charger (BQ24075)
# ========================================
# Charger connected to switched battery input
BQ24075(
    name = "U_CHARGER",
    vin = VBUS_5V,
    vbat = VBAT_SWITCHED,  # Switched battery input
    vsys = VSYS,           # System output (always on when USB or battery)
    gnd = GND,
    chg_status = chg_stat,
    pg_status = pg_stat,
    properties = {
        "collapse": True
    }
)

# Status signal pull-ups (pulled to VDD_3V3 to match ESP32 GPIO voltage domain)
# VSYS can reach 5V from USB; pulling to VDD_3V3 keeps signals within GPIO spec
Resistor(name = "R_CHG_STAT", value = "100kohm 5%", package = "0402",
         P1 = chg_stat, P2 = VDD_3V3.NET)
Resistor(name = "R_PG_STAT", value = "100kohm 5%", package = "0402",
         P1 = pg_stat, P2 = VDD_3V3.NET)

# ========================================
# 3.3V Buck-Boost Converter (TPS63070)
# ========================================
# Buck-boost powered from VSYS (supports full battery voltage range 2.5V-5V)
# EN and PG pins handled internally by module (always-on configuration)
#
# Battery under-voltage protection:
# TPS63070 operates down to 2.0V, but Li-Ion cells should not discharge below 3.0V
# Firmware must monitor MAX17048 SOC and shutdown at 5% (~3.2V) to preserve battery life
TPS63070(
    name = "U_BUCKBOOST",
    vin = VSYS,
    vout = VDD_3V3,
    gnd = GND,
    properties = {
        "collapse": True
    }
)

# ========================================
# ESP32-S3 Microcontroller
# ========================================
# Power sequencing: EN has 10ms RC delay ensuring VDD_3V3 is stable before ESP32 starts
uart_gnss = Uart("UART_GNSS")
spi_sd = Spi("SPI_SD")
i2c_main = I2c("I2C_MAIN")

ESP32S3WROOM1(
    name = "U_MCU",
    vdd_3v3 = VDD_3V3,
    gnd = GND,
    usb = usb_data,
    en = esp_en,
    gpio0 = esp_boot,  # Boot button
    # GPIO assignments
    gpio1 = mic_in,           # GPIO/ADC input from microphone
    gpio2 = btn_record,       # Record button
    gpio4 = led_r,            # RGB LED - Red
    gpio5 = led_g,            # RGB LED - Green  
    gpio6 = led_b,            # RGB LED - Blue
    gpio7 = chg_stat,         # Charger status
    gpio8 = pg_stat,          # Power good status
    gpio9 = fg_alert,         # Fuel gauge alert
    gpio10 = Gpio(NET = spi_sd.CS),   # SD card chip select
    gpio11 = Gpio(NET = spi_sd.MOSI), # SD card MOSI
    gpio12 = Gpio(NET = spi_sd.CLK),  # SD card clock
    gpio13 = Gpio(NET = spi_sd.MISO), # SD card MISO
    gpio14 = sd_detect,       # SD card detect
    gpio15 = Gpio(NET = uart_gnss.RX),    # ESP32 GPIO15 TX → GNSS RXD (receives from ESP32)
    gpio16 = Gpio(NET = uart_gnss.TX),    # ESP32 GPIO16 RX ← GNSS TXD (transmits to ESP32)
    # I2C for fuel gauge
    gpio21 = Gpio(NET = i2c_main.SDA),
    gpio47 = Gpio(NET = i2c_main.SCL),
    properties = {
        "collapse": True
    }
)

# ESP32 boot button circuit
# Boot button with ESD protection series resistor
_boot_sw = Net("BOOT_SW")  # Button side of ESD resistor

Resistor(name = "R_BOOT_PU", value = "10kohm 5%", package = "0402", 
         P1 = VDD_3V3.NET, P2 = esp_boot)

# ESD series resistor (limits current during ESD events)
Resistor(name = "R_BOOT_ESD", value = "470ohm 5%", package = "0402",
         P1 = _boot_sw, P2 = esp_boot)

TactileButton(
    name = "SW_BOOT",
    P1 = _boot_sw,
    P2 = GND.NET,
    properties = {
        "collapse": True
    }
)

# ESP32 reset button circuit
# Reset button with ESD protection series resistor
# Note: EN pin already has pull-up in ESP32S3WROOM1x module
_reset_sw = Net("RESET_SW")  # Button side of ESD resistor

Resistor(name = "R_RESET_ESD", value = "470ohm 5%", package = "0402",
         P1 = _reset_sw, P2 = esp_en)

TactileButton(
    name = "SW_RESET",
    P1 = _reset_sw,
    P2 = GND.NET,
    properties = {
        "collapse": True
    }
)

# ========================================
# I2C Bus Configuration
# ========================================
# Pull-up resistors: 10kΩ for low power consumption (0.33mA vs 0.7mA with 4.7kΩ)
# I2C clock: Use 100kHz in firmware (10kΩ pull-ups give 330ns rise time, marginal for 400kHz)
Resistor(name = "R_I2C_SDA", value = "10kohm 5%", package = "0402",
         P1 = i2c_main.SDA, P2 = VDD_3V3.NET)
Resistor(name = "R_I2C_SCL", value = "10kohm 5%", package = "0402",
         P1 = i2c_main.SCL, P2 = VDD_3V3.NET)

# ========================================
# Fuel Gauge (MAX17048)
# ========================================
# VCC powered from VBAT_RAW via voltage divider to maintain state when device is off
# Voltage divider: 100kΩ + 180kΩ → 2.7V from 4.2V battery (within 3.6V max spec)
# Preserves learned battery capacity across power cycles for accurate SOC tracking

_FG_VCC = Net("FG_VCC")

Resistor(name = "R_FG_DIV_TOP", value = "100kohm 5%", package = "0402",
         P1 = VBAT_RAW.NET, P2 = _FG_VCC)
Resistor(name = "R_FG_DIV_BOT", value = "180kohm 5%", package = "0402",
         P1 = _FG_VCC, P2 = GND.NET)
Capacitor(name = "C_FG_VCC", value = "1uF", voltage = "10V", package = "0402",
          P1 = _FG_VCC, P2 = GND.NET)

MAX17048(
    name = "U_FUELGAUGE",
    vcc = Power(NET = _FG_VCC),
    vbat = VBAT_RAW,
    gnd = GND,
    i2c = i2c_main,
    alert = fg_alert,
    properties = {
        "collapse": True
    }
)

# ========================================
# GNSS Module (MAX-M10S)
# ========================================
# V_BCKP voltage divider for hot start capability
# VBAT_RAW (4.2V max) exceeds V_BCKP spec (3.6V max), so use voltage divider
# Voltage divider: 100kΩ + 180kΩ creates 2.7V from 4.2V battery
# This maintains GNSS RTC and BBR memory for hot start (~1-2s TTFF instead of 30s cold start)

_GNSS_VBCKP = Net("GNSS_VBCKP")  # Divided voltage for GNSS backup

# Voltage divider: VBAT_RAW → 100kΩ → GNSS_VBCKP → 180kΩ → GND
Resistor(name = "R_GNSS_BCKP_TOP", value = "100kohm 5%", package = "0402",
         P1 = VBAT_RAW.NET, P2 = _GNSS_VBCKP)
Resistor(name = "R_GNSS_BCKP_BOT", value = "180kohm 5%", package = "0402",
         P1 = _GNSS_VBCKP, P2 = GND.NET)

MAXM10S(
    name = "U_GNSS",
    vcc = VDD_3V3,
    gnd = GND,
    uart = uart_gnss,
    rf_in = Net("GNSS_RF_IN"),  # RF input from u.FL connector (defined in module)
    v_bckp = Power(NET = _GNSS_VBCKP),  # Backup voltage for hot start capability
    reset_n = gnss_reset,
    timepulse = gnss_pps,
    properties = {
        "collapse": True
    }
)

# GNSS antenna connection (u.FL connector already in MAXM10Sx module)
# External active antenna will be connected to the u.FL connector

# ========================================
# MicroSD Card Socket
# ========================================
# SD card nets for unused data lines
_sd_dat1 = Net("SD_DAT1")
_sd_dat2 = Net("SD_DAT2")

MicroSDSocket(
    name = "J_SD",
    VDD = VDD_3V3.NET,
    VSS = GND.NET,
    CLK = spi_sd.CLK,
    CMD = spi_sd.MOSI,
    CD_DAT3 = spi_sd.CS,  # DAT3 in SD mode, CS in SPI mode
    DAT0 = spi_sd.MISO,
    DAT1 = _sd_dat1,  # Not used in SPI mode, but needs pull-up
    DAT2 = _sd_dat2,  # Not used in SPI mode, but needs pull-up
    CD1 = sd_detect,
    # All 7 GND pins connected to ground
    GND_1 = GND.NET,
    GND_2 = GND.NET,
    GND_3 = GND.NET,
    GND_4 = GND.NET,
    GND_5 = GND.NET,
    GND_6 = GND.NET,
    GND_7 = GND.NET,
    properties = {
        "collapse": True
    }
)

# SD card pull-ups
Resistor(name = "R_SD_CS", value = "10kohm 5%", package = "0402", 
         P1 = spi_sd.CS, P2 = VDD_3V3.NET)
# Unused data lines pulled up to prevent floating (10kΩ per SD spec recommendation)
Resistor(name = "R_SD_DAT1", value = "10kohm 5%", package = "0402",
         P1 = _sd_dat1, P2 = VDD_3V3.NET)
Resistor(name = "R_SD_DAT2", value = "10kohm 5%", package = "0402",
         P1 = _sd_dat2, P2 = VDD_3V3.NET)
# Card detect pull-up (CD switch pulls to GND when card inserted)
Resistor(name = "R_SD_DETECT", value = "10kohm 5%", package = "0402",
         P1 = sd_detect, P2 = VDD_3V3.NET)

# ========================================
# Analog Power Filtering
# ========================================
# Ferrite bead filter to isolate analog circuits from digital switching noise
# This prevents buck-boost switching noise and WiFi noise from coupling into audio
# Ferrite bead spec: 600Ω@100MHz impedance, <0.3Ω DC resistance, 500mA rating
# Recommended part: Murata BLM21PG601SN1D (600Ω@100MHz) or similar
# Note: Value represents approximate DC inductance; actual filtering is via AC impedance
Inductor(name = "FB_ANA", value = "1uH", current = "500mA", package = "0805",
         P1 = VDD_3V3.NET, P2 = VDD_3V3_ANA.NET)

# Filter capacitors for analog rail (dual-stage filtering)
Capacitor(name = "C_ANA_FILT1", value = "10uF", voltage = "10V", package = "0805",
          P1 = VDD_3V3_ANA.NET, P2 = GND.NET)
Capacitor(name = "C_ANA_FILT2", value = "100nF", voltage = "10V", package = "0402",
          P1 = VDD_3V3_ANA.NET, P2 = GND.NET)

# ========================================
# Analog Microphone Input
# ========================================
AnalogMicInput(
    name = "MIC",
    vdd_3v3 = VDD_3V3_ANA,  # Use filtered analog rail
    gnd = GND,
    mic_out = Analog(NET = mic_in),
    properties = {
        "collapse": True
    }
)

# ========================================
# User Interface
# ========================================

# Record Button circuit with ESD protection
_record_sw = Net("RECORD_SW")  # Button side of ESD resistor

Resistor(name = "R_BTN_RECORD_PU", value = "10kohm 5%", package = "0402",
         P1 = VDD_3V3.NET, P2 = btn_record)

# ESD series resistor (limits current during ESD events from user contact)
Resistor(name = "R_BTN_RECORD_ESD", value = "470ohm 5%", package = "0402",
         P1 = _record_sw, P2 = btn_record)

TactileButton(
    name = "SW_RECORD",
    P1 = _record_sw,
    P2 = GND.NET,
    properties = {
        "collapse": True
    }
)

# RGB LED (common-cathode configuration)
# Current-balanced for accurate color mixing (~8mA per LED)
# Red LED: Vf~2.0V, I=8.7mA with 150Ω
_led_r_anode = Net("LED_R_ANODE")
Resistor(name = "R_LED_R", value = "150ohm 5%", package = "0402",
         P1 = led_r, P2 = _led_r_anode)
Led(name = "LED_R", color = "red", package = "0603",
    A = _led_r_anode, K = GND)

# Green LED: Vf~3.0V, I=7.7mA with 39Ω (balanced with blue)
_led_g_anode = Net("LED_G_ANODE")
Resistor(name = "R_LED_G", value = "39ohm 5%", package = "0402",
         P1 = led_g, P2 = _led_g_anode)
Led(name = "LED_G", color = "green", package = "0603",
    A = _led_g_anode, K = GND)

# Blue LED: Vf~3.0V, I=7.7mA with 39Ω (balanced with green)
_led_b_anode = Net("LED_B_ANODE")
Resistor(name = "R_LED_B", value = "39ohm 5%", package = "0402",
         P1 = led_b, P2 = _led_b_anode)
Led(name = "LED_B", color = "blue", package = "0603",
    A = _led_b_anode, K = GND)

# Power indicator LED (with current-limiting resistor)
# Connected to VDD_3V3 for constant brightness
_led_pwr_anode = Net("LED_PWR_ANODE")
Resistor(name = "R_LED_PWR", value = "150ohm 5%", package = "0402",
         P1 = VDD_3V3.NET, P2 = _led_pwr_anode)
Led(name = "LED_PWR", color = "green", package = "0603",
    A = _led_pwr_anode, K = GND)

# ========================================
# Bulk Decoupling Capacitors
# ========================================
Capacitor(name = "C_BULK_3V3", value = "100uF", voltage = "10V", package = "1206", 
          P1 = VDD_3V3.NET, P2 = GND.NET)
Capacitor(name = "C_BULK_VSYS", value = "47uF", voltage = "10V", package = "0805",
          P1 = VSYS.NET, P2 = GND.NET)
Capacitor(name = "C_BULK_VBAT", value = "10uF", voltage = "10V", package = "0805",
          P1 = VBAT_RAW.NET, P2 = GND.NET)

# ========================================
# Test Points
# ========================================
# Test points for prototype debugging and production testing
TestPoint = Module("@stdlib/generics/TestPoint.zen")
TestPoint(name = "TP_VBAT", variant = "Pad_D1.0mm", P1 = VBAT_RAW.NET)
TestPoint(name = "TP_VSYS", variant = "Pad_D1.0mm", P1 = VSYS.NET)
TestPoint(name = "TP_3V3", variant = "Pad_D1.0mm", P1 = VDD_3V3.NET)
TestPoint(name = "TP_3V3_ANA", variant = "Pad_D1.0mm", P1 = VDD_3V3_ANA.NET)
TestPoint(name = "TP_MIC_IN", variant = "Pad_D1.0mm", P1 = mic_in)
TestPoint(name = "TP_I2C_SDA", variant = "Pad_D1.0mm", P1 = i2c_main.SDA)
TestPoint(name = "TP_I2C_SCL", variant = "Pad_D1.0mm", P1 = i2c_main.SCL)
TestPoint(name = "TP_GND", variant = "Pad_D1.0mm", P1 = GND.NET)

# ========================================
# Mounting Holes
# ========================================
# 4× M2.5 mounting holes for mechanical attachment to enclosure
# Place at corners with minimum 3mm edge distance
MountingHole = Module("@stdlib/generics/MountingHole.zen")
MountingHole(name = "MH1", diameter = "M2.5", P1 = GND.NET)
MountingHole(name = "MH2", diameter = "M2.5", P1 = GND.NET)
MountingHole(name = "MH3", diameter = "M2.5", P1 = GND.NET)
MountingHole(name = "MH4", diameter = "M2.5", P1 = GND.NET)

# pcb:sch C_ANA_FILT.C x=2086.8800 y=-2756.9000 rot=0
# pcb:sch C_BULK_3V3.C x=-1405.6200 y=-2236.2000 rot=0
# pcb:sch C_BULK_VBAT.C x=-1253.2200 y=-2236.2000 rot=0
