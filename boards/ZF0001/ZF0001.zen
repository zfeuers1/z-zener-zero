# pcb:sch R_SD_DAT2.R x=471.4400 y=-2299.7000 rot=180
# pcb:sch R_SD_DETECT.R x=611.1400 y=-3264.9000 rot=180
# pcb:sch SW_BOOT x=1727.2000 y=-2286.0000 rot=0
# pcb:sch SW_PWR.CSSM1210TB x=-216.9000 y=-2350.5000 rot=270
# pcb:sch SW_RECORD x=1727.2000 y=-2425.7000 rot=0
# pcb:sch SW_RESET x=1727.2000 y=-2146.3000 rot=0
# pcb:sch USB x=1168.4000 y=-2336.8000 rot=0
