# pcb:sch VBAT_RAW.2 x=-1240.5200 y=-2350.5000 rot=0
# pcb:sch VBAT_SWITCHED.1 x=-630.9200 y=-3417.3000 rot=0
# pcb:sch VBAT_SWITCHED.3 x=1121.6800 y=-3379.2000 rot=0
# pcb:sch VBUS_5V.2 x=1362.9800 y=-3366.5000 rot=0
# pcb:sch VDD_3V3.1 x=-1050.0200 y=-2350.5000 rot=0
# pcb:sch VDD_3V3.2 x=-1392.9200 y=-2350.5000 rot=0
# pcb:sch VDD_3V3.3 x=1528.0800 y=-3290.3000 rot=0
# pcb:sch VDD_3V3.5 x=550.1800 y=-3404.6000 rot=0
# pcb:sch VDD_3V3_ANA.1 x=1934.4800 y=-3303.0000 rot=0
# pcb:sch VSYS.1 x=-1545.3200 y=-2350.5000 rot=0
# pcb:sch VSYS.2 x=-935.7200 y=-2350.5000 rot=0
# pcb:sch VSYS.3 x=1007.3800 y=-3379.2000 rot=0
